# ==============================================================================
# Open-Source AI WhatsApp CRM & Super Agent (.env.example)
# Safe template containing placeholders only — NEVER commit live credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_LOCALE=en
PORT=3001

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Backend Service Role Secret Key (Server-only; bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Auth JWKS URL for token signature verification
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 3. ENCRYPTION & SECURITY KEYS
# ------------------------------------------------------------------------------
# 32-byte hex string (64 characters) used for AES-256-GCM encryption of stored API keys
# Generate on CLI: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta App Secret (Used to verify incoming X-Hub-Signature-256 webhooks)
META_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# 4. OFFICIAL META WHATSAPP BUSINESS CLOUD API (Optional if using Mock mode)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ------------------------------------------------------------------------------
# 5. LOCAL AI / OLLAMA & LITELLM GATEWAY (Zero-cost local inference)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_BASE_URL=http://localhost:4000
DEFAULT_AI_MODEL=gpt-5.4-mini

# ------------------------------------------------------------------------------
# 6. SHOPIFY E-COMMERCE INTEGRATION (Optional)
# ------------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-brand.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
